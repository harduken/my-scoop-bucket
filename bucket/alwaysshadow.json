{
    "version": "1.666",
    "description": "Makes sure Shadowplay's Instant Replay feature is on.",
    "homepage": "https://github.com/Verpous/AlwaysShadow",
    "license": "GPL-3.0 license",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Verpous/AlwaysShadow/releases/download/v1.666/AlwaysShadow.zip",
            "hash": "ccfdcc54027409523552ef43150a33d3e512786a487a818d80859561c3d74201"
        }
    },
    "bin": "AlwaysShadow.exe",
    "notes": "Run AlwaysShadow.exe. The program will make sure to turn Instant Replay back on should it ever turn off. Additionally, there is a system tray icon with options, including running at startup (recommended). For this program to work, turn on In-Game Overlay in your GeForce Experience settings. Some programs (such as Netflix) prevent Instant Replay from being active; you can whitelist such programs by creating a Whitelist.txt next to the executable and adding one process command line per line. See the project README for advanced whitelisting options.",
    "shortcuts": [["AlwaysShadow.exe", "Always Shadow"]],
    "persist": [
        "AlwaysShadow",
        "Whitelist.txt"
    ],
    "post_install": [
        "$dataDir = Join-Path $persist_dir 'AlwaysShadow'",
        "if (!(Test-Path $dataDir)) { New-Item -ItemType Directory -Path $dataDir | Out-Null }",
        "$whitelist = Join-Path $persist_dir 'Whitelist.txt'",
        "if (!(Test-Path $whitelist)) { New-Item -ItemType File -Path $whitelist | Out-Null }",
        "$local = Join-Path $env:LOCALAPPDATA 'AlwaysShadow'",
        "if (Test-Path $local -and -not (Get-Item $local).Attributes.ToString().Contains('ReparsePoint')) { Remove-Item $local -Recurse -Force }",
        "if (!(Test-Path $local)) { New-Item -ItemType Junction -Path $local -Target $dataDir | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/Verpous/AlwaysShadow",
        "regex": "/releases/tag/(?<prefix>v?\\.?)(?<version>[\\w-\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Verpous/AlwaysShadow/releases/download/$matchPrefix$version/AlwaysShadow.zip"
            }
        }
    }
}
