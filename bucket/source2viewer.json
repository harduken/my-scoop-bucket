{
    "version": "16.0",
    "description": "Valve's Source 2 resource file format parser, decompiler, and exporter.",
    "homepage": "https://valveresourceformat.github.io/",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/ValveResourceFormat/ValveResourceFormat/blob/master/LICENSE"
    },
    "notes": [
        "Source 2 Viewer keeps its settings in %LocalAppData%/Source2Viewer/settings.vdf."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ValveResourceFormat/ValveResourceFormat/releases/download/16.0/Source2Viewer.exe",
            "hash": "sha256:80cee9a572feec30d3b5aacd415254b4046285372eadf2f8d08e7168f7f5e280"
        }
    },
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\Source2Viewer\") -and (Test-Path \"$env:USERPROFILE\\Source2Viewer\")) {",
        "    info \"Moving configs to persist directory...\"",
        "    Copy-Item -Path \"$env:USERPROFILE\\Source2Viewer\\*\" -Destination \"$persist_dir\\Source2Viewer\" -Force -Recurse | Out-Null",
        "}"
    ],
    "bin": "Source2Viewer.exe",
    "shortcuts": [["Source2Viewer.exe", "Source 2 Viewer"]],
    "persist": ["Source2Viewer"],
    "uninstaller": {
        "script": [
            "'source2viewer.json' | ForEach-Object {",
            "   Copy-Item -Force \"$dir\\$_\" \"$persist_dir\\$_.bak\"",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/ValveResourceFormat/ValveResourceFormat"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ValveResourceFormat/ValveResourceFormat/releases/download/$version/Source2Viewer.exe",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
